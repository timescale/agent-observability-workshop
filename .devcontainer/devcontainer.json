{
  "name": "agent-observability-workshop",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Grafana runs as a sibling container via docker-compose, so we need a
  // Docker daemon inside the Codespace.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Grafana. forwardPorts is explicit because Codespaces' automatic port
  // detection does not reliably notice a process listening inside a sibling
  // container rather than the devcontainer itself.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "workbench.secondarySideBar.defaultVisibility": "hidden"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "postStartCommand": "bash .devcontainer/post-start.sh",

  "remoteUser": "vscode"
}